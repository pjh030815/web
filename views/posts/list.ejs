<div class="my-5">
    <h1 class="text-center mb-5">게시글</h1>
    <div class="text-end mb-2">
        <button class="btn btn-link px-5 btn-insert">글쓰기</button>
    </div>
    <form id="searchForm" class="mb-2">
        <div class="input-group" style="width: 185px;">
            <input type="text" class="form-control form-control-sm" id="keyword" name="keyword" placeholder="검색">
            <button class="btn btn-primary btn-sm" type="submit">검색</button>
        </div>
    </form>
    <table id="tbl" class="table table-striped table-hover"></table>
    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page" class="mx-3"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>
    <script id="temp" type="text/x-handlebars-template">
        <thead>
            <tr>
                <td>번호</td><td>제목</td><td>글쓴이</td><td>날짜</td>
            </tr>
        </thead>
        <tbody>
        {{#each .}}
        <tr>
            <td>{{ID}}</td>
            <td><a href="/posts/{{ID}}">{{TITLE}}</a></td>
            <td>{{SNAME}}({{WRITER}})</td>
            <td>{{FMT_DATE}}</td>
         </tr>
        {{else}}
        <tr>
            <td colspan="4" class="text-center">검색 결과가 없습니다.</td>
        </tr>
        {{/each}}
        </tbody>
    </script>
</div>
<script>
    let page=1;
    let size=5;
    getList();

     $(".btn-insert").on("click", function(){
        if(scode){
            location.href='/posts/insert';
        }else{
            sessionStorage.setItem("target", "/posts/insert");
            location.href='/users/login';
        }
    });

    $("#searchForm").on("submit", function(e){
        e.preventDefault();
        page=1;
        getList();
    });

    $("#next").on("click", function(){
        page++;
        getList();
    });

    $("#prev").on("click", function(){
        page--;
        getList();
    });

    function getList(){
        console.log(page, size);
        $.ajax({
            type:"get",
            url:"/posts/list.json",
            data:{page, size, keyword:$("#keyword").val()},
            success:function(data) {
                console.log(data);
                const temp = Handlebars.compile($("#temp").html());
                $("#tbl").html(temp(data.list));
                const last = Math.max(Math.ceil(data.total/size), 1);
                $("#page").html(`${page}/${last}`);

                //1페이지에서 이전 버튼을 클릭한 경우
                if(page==1) $("#prev").attr("disabled", true); 
                else  $("#prev").attr("disabled", false);
                //마지막 페에지에서 다음 버튼을 클릭한 경우
                if(page>=last) $("#next").attr("disabled", true); 
                else  $("#next").attr("disabled", false);
            }
        })
    }
</script>
